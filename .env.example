# Source this file after copying to .env. Keep credentials out of Git.
export OPENROUTER_API_KEY=""
# Defaults to this checkout's .work directory. Prefer a large data disk.
# export RSI_WORKSPACE="/your/data/rsi-work"
# Use your existing Docker daemon. Rootful and rootless Docker are supported.
# export DOCKER_HOST="unix:///run/user/1000/docker.sock"
# export DOCKER_CONFIG="/your/docker-config-with-compose-plugin"
# export RSI_DOCKER_BINARY="/your/path/docker"
# Public data/image downloads; choose the endpoint appropriate for your network.
export HF_ENDPOINT="https://huggingface.co"
# export HF_ENDPOINT="https://hf-mirror.net"
# Model and host proxy routes are opt-in, and are recorded in experiment config.
export RSI_MODEL_PROXY=""
export RSI_HOST_PROXY=""
# Public Go dependency hydration is used only for isolated private graders.
# export RSI_GO_BINARY="/your/go1.25/bin/go"
