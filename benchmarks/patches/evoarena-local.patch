+            {
+                "phase": "validation",
+                "benchmark": "Terminal-Bench-Evo",
+                "family_id": chain_id,
+                "task_id": task_dir.name,
+                "instruction": _read_text(task_dir / "instruction.md"),
+            },
+        )
+        if "delegate" not in output:
