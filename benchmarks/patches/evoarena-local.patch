+                "rollout-time open-ended self-modification",
+            )
+        )
+    except Exception as exc:  # noqa: BLE001
+        return {"selected": False, "reason": f"stage_rejected: {exc}"}
+
+    protocol: dict[str, Any]
+    executor = DockerProgramExecutor(timeout=15)
+    try:
+        executor.bind(store.root)
+        output = executor.run(
