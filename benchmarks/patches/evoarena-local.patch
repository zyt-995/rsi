+++ b/EvoMem-TerminalBench-Evo/harbor_EvoMem/harbor_EvoMem/agents/terminus2_open_ended.py
@@ -0,0 +1,231 @@
+"""Terminus2 controlled by a verifier-gated executable policy program."""
+
+from __future__ import annotations
+
+import json
+from pathlib import Path, PurePosixPath
+from typing import Any, Optional
+
+from harbor.environments.base import BaseEnvironment
+from harbor.models.agent.context import AgentContext
+
+from rsi_harness.program import DockerProgramExecutor, ProgramStore
+
+from .. import family_trace_memory
+from ..chain_id import derive_chain_id
+from .terminus2_baseline import Terminus2Baseline
+
+
+PROGRAM_DIR = "/app/.rsi/program"
+ALLOWED_SUFFIXES = {".py", ".json", ".md", ".txt"}
+
+
+class Terminus2OpenEnded(Terminus2Baseline):
+    """Allow the rollout to replace an executable, multi-file policy.
+
+    The active program runs in the project's locked-down program sandbox and
+    may return delegate instructions for Terminus2.  During the rollout the
+    model may replace files in ``/app/.rsi/program``.  This class only captures
+    the proposal; the trusted chain runner performs a fresh-task replay and
+    activates it only on strict score/cost improvement.
+    """
+
+    def __init__(
+        self,
+        chain_id: Optional[str] = None,
+        host_root: Optional[str] = None,
+        program_directory: Optional[str] = None,
+        allow_self_modify: bool = True,
+        proposal_mode: str = "optional",
+        program_char_budget: int = 131_072,
+        *args: Any,
+        **kwargs: Any,
+    ) -> None:
+        self._explicit_chain_id = chain_id
+        self._host_root = host_root
+        self._program_directory = program_directory
+        self._allow_self_modify = _as_bool(allow_self_modify)
+        self._proposal_mode = str(proposal_mode).strip().lower()
+        self._program_char_budget = max(4096, min(int(program_char_budget), 131_072))
+        super().__init__(*args, **kwargs)
+
+    async def run(  # type: ignore[override]
+        self,
+        instruction: str,
+        environment: BaseEnvironment,
+        context: AgentContext,
+    ) -> None:
+        extra_env = self._extra_env or {}
+        chain_id = derive_chain_id(
+            environment.environment_name,
+            self._explicit_chain_id or extra_env.get("HARBOR_EVOMEM_CHAIN_ID"),
+        )
+        host_root = self._host_root or extra_env.get("HARBOR_EVOMEM_HOST_ROOT")
+        if not host_root:
+            raise ValueError("Terminus2OpenEnded requires host_root")
+        store = ProgramStore(Path(host_root) / "program_store", max_bytes=self._program_char_budget)
+        program_dir = Path(self._program_directory).resolve() if self._program_directory else store.active_directory()
+        try:
+            program_dir.relative_to(store.root.resolve())
+        except ValueError as exc:
+            raise ValueError("program_directory must be inside the program store") from exc
+
+        initial_files = _read_program_files(program_dir)
+        await family_trace_memory.hydrate_workspace_text_files(
+            environment,
+            {f"{PROGRAM_DIR}/{name}": content for name, content in initial_files.items()},
+            logger=self.logger,
+        )
+        delegate = _execute_delegate(
+            store,
+            program_dir,
+            {
+                "phase": "act",
+                "benchmark": "Terminal-Bench-Evo",
+                "family_id": chain_id,
+                "task_id": environment.environment_name,
+                "instruction": instruction,
+            },
+        )
+        policy_lines = [
+            "<!-- BEGIN OPEN-ENDED-SELF-MODIFICATION -->",
+            f"The active executable agent program is mirrored at `{PROGRAM_DIR}`.",
+            "Its sandboxed output for this task follows:",
+            delegate or "(no additional delegate instructions)",
+        ]
+        if self._allow_self_modify:
+            policy_lines.extend(
+                [
+                    "You may replace any of its .py/.json/.md/.txt files during this rollout, including adding files.",
+                    "`agent.py` must remain the entrypoint and read one JSON request from stdin, then emit exactly one JSON object with a `delegate` field.",
+                    "Treat the directory as a complete replacement program, not a task-answer scratchpad.",
+                    "A changed program is deployed only if a trusted fresh replay is strictly better in score or positive-score cost.",
+                    "Leaving the program unchanged is a valid decision.",
+                ]
+            )
+            if self._proposal_mode == "evolution":
+                policy_lines.extend(
+                    [
+                        "This rollout is one member of an evolutionary population from a shared parent.",
+                        "Before marking the task complete, produce a valid changed program so the trusted runner can replay and rank it against sibling candidates.",
+                        "Favor a small general policy mutation grounded in this trajectory, not task-specific answer text.",
+                    ]
+                )
+        else:
+            policy_lines.append("This is a read-only shadow evaluation; do not modify the program.")
+        policy_lines.append("<!-- END OPEN-ENDED-SELF-MODIFICATION -->")
+        injected = "\n".join(policy_lines) + "\n\n" + instruction
+
+        try:
+            await super().run(instruction=injected, environment=environment, context=context)
+        finally:
+            if self._allow_self_modify:
+                candidate_files = await _capture_program_files(
+                    environment,
+                    logger=self.logger,
+                    byte_limit=self._program_char_budget,
+                )
+                if not candidate_files:
+                    candidate_files = initial_files
+                _write_candidate(
+                    Path(self.logs_dir),
+                    task_name=environment.environment_name,
+                    initial_files=initial_files,
+                    candidate_files=candidate_files,
+                )
+
+
+def _read_program_files(directory: Path) -> dict[str, str]:
+    files: dict[str, str] = {}
+    for path in sorted(directory.rglob("*")):
+        if path.is_file() and path.name != "metadata.json" and path.suffix in ALLOWED_SUFFIXES:
+            files[path.relative_to(directory).as_posix()] = path.read_text(encoding="utf-8")
+    return files
+
+
+def _execute_delegate(store: ProgramStore, directory: Path, request: dict[str, Any]) -> str:
+    executor = DockerProgramExecutor(timeout=15)
+    try:
+        executor.bind(store.root)
+        output = executor.run(directory, request)
+    finally:
+        executor.close()
+    delegate = output.get("delegate")
+    if not isinstance(delegate, dict):
+        return ""
+    instructions = delegate.get("instructions", "")
+    return instructions[:32_768] if isinstance(instructions, str) else ""
+
+
+async def _capture_program_files(
+    environment: BaseEnvironment,
+    *,
+    logger: Any,
+    byte_limit: int,
+) -> dict[str, str]:
+    listing = await environment.exec(
+        f"find {PROGRAM_DIR} -maxdepth 8 -type f -print 2>/dev/null | sort | head -32",
+        timeout_sec=30,
+    )
+    paths: list[str] = []
+    for raw in (listing.stdout or "").splitlines():
+        path = raw.strip()
+        if not path.startswith(PROGRAM_DIR + "/"):
+            continue
+        rel = path[len(PROGRAM_DIR) + 1 :]
+        pure = PurePosixPath(rel)
+        if pure.is_absolute() or ".." in pure.parts or pure.suffix not in ALLOWED_SUFFIXES:
+            continue
+        paths.append(path)
+    snapshots = await family_trace_memory.capture_file_snapshots(
+        environment,
+        paths,
+        logger=logger,
+        byte_limit=max(1024, byte_limit // max(1, len(paths))),
+    )
+    return {path[len(PROGRAM_DIR) + 1 :]: content for path, content in snapshots.items()}
+
+
+def _write_candidate(
+    logs_dir: Path,
+    *,
+    task_name: str,
+    initial_files: dict[str, str],
+    candidate_files: dict[str, str],
+) -> None:
+    out = logs_dir / "harbor_evomem" / "open_ended"
+    out.mkdir(parents=True, exist_ok=True)
+    # Shell heredocs and snapshot extraction commonly add/drop one terminal
+    # newline.  Treat trailing whitespace-only differences as the same program
+    # so they do not consume an expensive fresh-task replay.
+    canonical_initial = {name: content.rstrip() for name, content in initial_files.items()}
+    canonical_candidate = {name: content.rstrip() for name, content in candidate_files.items()}
+    changed = canonical_candidate != canonical_initial
+    (out / "candidate_files.json").write_text(
+        json.dumps(candidate_files, indent=2, ensure_ascii=False) + "\n",
+        encoding="utf-8",
+    )
+    (out / "candidate.json").write_text(
+        json.dumps(
+            {
+                "task_name": task_name,
+                "changed": changed,
+                "files": sorted(candidate_files),
+                "total_chars": sum(len(value) for value in candidate_files.values()),
+            },
+            indent=2,
+            ensure_ascii=False,
+        )
+        + "\n",
+        encoding="utf-8",
+    )
+
+
+def _as_bool(value: Any) -> bool:
+    if isinstance(value, bool):
+        return value
+    if value is None:
+        return False
+    if isinstance(value, str):
+        return value.strip().lower() not in {"0", "false", "no", "off", ""}
+    return bool(value)
