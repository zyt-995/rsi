+"""Terminus2 with an explicit, optional self-improvement action."""
+
+from __future__ import annotations
+
+from pathlib import Path
+from typing import Any, Optional
+
+from harbor.environments.base import BaseEnvironment
+from harbor.models.agent.context import AgentContext
+
+from .. import continual_artifacts, family_trace_memory
+from ..chain_id import derive_chain_id
+from .terminus2_baseline import Terminus2Baseline
+
+
+SELF_ACTION_OPEN = "<!-- BEGIN SELF-IMPROVE-AS-ACTION -->"
+SELF_ACTION_CLOSE = "<!-- END SELF-IMPROVE-AS-ACTION -->"
+
+
+class Terminus2SelfAction(Terminus2Baseline):
+    """Expose a persistent memory file as a genuine rollout-time action.
+
+    The model may edit ``/app/.rsi/MEMORY.md`` with its ordinary terminal tool
+    at any point in the rollout.  The candidate is captured after the rollout;
+    ``run_chain.py`` promotes it only after the official verifier returns a
+    positive reward.  Choosing not to edit the file is recorded as no change.
+    """
+
+    def __init__(
+        self,
+        chain_id: Optional[str] = None,
+        host_root: Optional[str] = None,
+        artifact_char_budget: int = 8_000,
+        *args: Any,
+        **kwargs: Any,
+    ) -> None:
+        self._explicit_chain_id = chain_id
+        self._host_root = host_root
+        self._artifact_char_budget = max(512, min(int(artifact_char_budget), 32_000))
+        super().__init__(*args, **kwargs)
+
+    async def run(  # type: ignore[override]
+        self,
+        instruction: str,
+        environment: BaseEnvironment,
+        context: AgentContext,
+    ) -> None:
+        extra_env = self._extra_env or {}
+        chain_id = derive_chain_id(
+            environment.environment_name,
+            self._explicit_chain_id or extra_env.get("HARBOR_EVOMEM_CHAIN_ID"),
+        )
+        host_root = self._host_root or extra_env.get("HARBOR_EVOMEM_HOST_ROOT")
+        if not host_root:
+            raise ValueError("Terminus2SelfAction requires host_root")
+
+        active = continual_artifacts.load_active(
+            host_root,
+            "self_action",
+            continual_artifacts.SELF_ACTION_DEFAULT,
+        )[: self._artifact_char_budget]
+        await family_trace_memory.hydrate_workspace_text_files(
+            environment,
+            {continual_artifacts.SELF_ACTION_WORKSPACE_FILE: active},
+            logger=self.logger,
+        )
+        policy = "\n".join(
+            [
+                SELF_ACTION_OPEN,
+                "You have one optional self-improvement action during this rollout.",
+                f"Persistent family memory is at `{continual_artifacts.SELF_ACTION_WORKSPACE_FILE}`.",
+                "You may inspect or edit that file with terminal commands whenever you decide it is worth the cost.",
+                "Store only compact, reusable procedures or environment facts for later releases; never store the current answer or hidden-test guesses.",
+                "An edit is only committed if the official verifier accepts this task. Leaving the file unchanged is a valid decision.",
+                f"Family id: `{chain_id}`.",
+                SELF_ACTION_CLOSE,
+            ]
+        )
+        injected = f"{policy}\n\n{instruction}"
+        try:
+            await super().run(instruction=injected, environment=environment, context=context)
+        finally:
+            snapshots = await family_trace_memory.capture_file_snapshots(
+                environment,
+                [continual_artifacts.SELF_ACTION_WORKSPACE_FILE],
+                logger=self.logger,
+                byte_limit=self._artifact_char_budget,
+            )
+            candidate = snapshots.get(continual_artifacts.SELF_ACTION_WORKSPACE_FILE, active)
+            continual_artifacts.write_candidate(
+                Path(self.logs_dir),
+                paradigm="self_action",
+                task_name=environment.environment_name,
+                initial=active,
+                candidate=candidate,
+            )
