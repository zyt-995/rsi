@@ -0,0 +1,119 @@
+"""Verifier-gated persistent artifacts for native Terminal-Bench agents."""
+
+from __future__ import annotations
+
+import hashlib
+import json
+import os
+import time
+from pathlib import Path
+from typing import Any
+
+
+SELF_ACTION_WORKSPACE_FILE = "/app/.rsi/MEMORY.md"
+SELF_ACTION_DEFAULT = """# Continual Agent Memory
+
+Keep only compact, reusable procedures or environment facts that may help on
+later releases in this task family. Do not copy the current task answer.
+"""
+
+
+def _sha256(text: str) -> str:
+    return hashlib.sha256(text.encode("utf-8")).hexdigest()
+
+
+def artifact_dir(host_root: str | Path, paradigm: str) -> Path:
+    return Path(host_root).expanduser().resolve() / "continual_artifacts" / paradigm
+
+
+def load_active(host_root: str | Path, paradigm: str, default: str = "") -> str:
+    path = artifact_dir(host_root, paradigm) / "active.md"
+    try:
+        return path.read_text(encoding="utf-8")
+    except FileNotFoundError:
+        return default
+
+
+def write_candidate(
+    logs_dir: str | Path,
+    *,
+    paradigm: str,
+    task_name: str,
+    initial: str,
+    candidate: str,
+) -> dict[str, Any]:
+    out = Path(logs_dir) / "harbor_evomem" / paradigm
+    out.mkdir(parents=True, exist_ok=True)
+    candidate = candidate[:32_000]
+    (out / "candidate.md").write_text(candidate, encoding="utf-8")
+    meta = {
+        "paradigm": paradigm,
+        "task_name": task_name,
+        "workspace_file": SELF_ACTION_WORKSPACE_FILE,
+        "initial_sha256": _sha256(initial),
+        "candidate_sha256": _sha256(candidate),
+        "changed": candidate.rstrip() != initial.rstrip(),
+        "candidate_chars": len(candidate),
+    }
+    (out / "candidate.json").write_text(
+        json.dumps(meta, indent=2, ensure_ascii=False) + "\n",
+        encoding="utf-8",
+    )
+    return meta
+
+
+def promote_candidate(
+    *,
+    host_root: str | Path,
+    paradigm: str,
+    task_name: str,
+    trial_dir: str | Path,
+) -> dict[str, Any]:
+    """Promote a changed candidate after the caller has checked reward > 0."""
+
+    trial = Path(trial_dir)
+    candidate_dir = trial / "agent" / "harbor_evomem" / paradigm
+    candidate_path = candidate_dir / "candidate.md"
+    meta_path = candidate_dir / "candidate.json"
+    if not candidate_path.is_file() or not meta_path.is_file():
+        return {"promoted": False, "reason": "candidate_missing"}
+    try:
+        meta = json.loads(meta_path.read_text(encoding="utf-8"))
+    except (OSError, json.JSONDecodeError) as exc:
+        return {"promoted": False, "reason": f"candidate_meta_invalid: {exc}"}
+    if not bool(meta.get("changed")):
+        return {"promoted": False, "reason": "agent_chose_no_change"}
+
+    candidate = candidate_path.read_text(encoding="utf-8")[:32_000]
+    if not candidate.strip():
+        return {"promoted": False, "reason": "candidate_empty"}
+
+    root = artifact_dir(host_root, paradigm)
+    revisions = root / "revisions"
+    revisions.mkdir(parents=True, exist_ok=True)
+    digest = _sha256(candidate)
+    stamp = time.strftime("%Y%m%dT%H%M%SZ", time.gmtime())
+    revision = revisions / f"{stamp}-{task_name}-{digest[:12]}"
+    revision.mkdir(parents=False, exist_ok=False)
+    (revision / "artifact.md").write_text(candidate, encoding="utf-8")
+    record = {
+        **meta,
+        "promoted": True,
+        "promoted_at": stamp,
+        "trial_dir": str(trial.resolve()),
+        "revision": str(revision),
+    }
+    (revision / "record.json").write_text(
+        json.dumps(record, indent=2, ensure_ascii=False) + "\n",
+        encoding="utf-8",
+    )
+
+    active = root / "active.md"
+    tmp = root / f".active.{os.getpid()}.tmp"
+    tmp.write_text(candidate, encoding="utf-8")
+    tmp.replace(active)
+    (root / "active.json").write_text(
+        json.dumps(record, indent=2, ensure_ascii=False) + "\n",
+        encoding="utf-8",
+    )
+    return record
