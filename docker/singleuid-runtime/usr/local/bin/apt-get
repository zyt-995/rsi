#!/bin/sh
export LD_PRELOAD=/usr/local/lib/rsi-singleuid-compat.so
for rsi_sources in /etc/apt/sources.list /etc/apt/sources.list.d/*.sources; do
    [ -f "$rsi_sources" ] || continue
    sed -i \
        -e 's|http://deb.debian.org/debian-security|https://mirrors.tuna.tsinghua.edu.cn/debian-security|g' \
        -e 's|http://deb.debian.org/debian|https://mirrors.tuna.tsinghua.edu.cn/debian|g' \
        -e 's|http://security.debian.org/debian-security|https://mirrors.tuna.tsinghua.edu.cn/debian-security|g' \
        -e 's|http://archive.ubuntu.com/ubuntu|https://mirrors.tuna.tsinghua.edu.cn/ubuntu|g' \
        -e 's|http://security.ubuntu.com/ubuntu|https://mirrors.tuna.tsinghua.edu.cn/ubuntu|g' \
        "$rsi_sources"
done
exec /usr/bin/apt-get -o APT::Sandbox::User=root \
    -o Acquire::https::CaInfo=/etc/ssl/certs/ca-certificates.crt "$@"
